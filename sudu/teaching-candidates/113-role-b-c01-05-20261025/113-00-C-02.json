  "teaching": {
    "topic": "113國文2｜如的一字多義：比得上",
    "teacherSummary": "『他植者雖窺伺傚慕，莫能如也』是說其他種樹者雖然觀察與模仿郭橐駝，也沒人能比得上他；如在此意為**及得上**。A『所如』是前往的地方；B『如線』與 C『悉如外人』是相像；只有 D『猶不如人』的如表示比得上，因『不』而成比不上，與原句同義。",
    "elementarySummary": "題目說其他人怎麼學也比不上他。A 的如是去哪裡；B、C 是像什麼；D 的『不如人』才是比不上別人，所以選 D。",
    "concept": "如有『往』、『像』、『及得上』等不同意義；莫能如與不如都屬能力比較。",
    "memory": "莫能如＝比不上；猶不如人＝還比不上；D。",
    "solvingSteps": [
      "把莫能如也譯作沒人能比得上他。",
      "A 所如是小舟前往之處，排除。",
      "B 如線和 C 如外人都是相像義，排除。",
      "D 不如人表示比不上，與題幹相同，選 D。"
    ],
    "optionExplanations": {
      "A": {
        "teacher": "『縱一葦之所如』是任小舟前往哪兒，如表往或到，不是能力比較。",
        "elementary": "A 是小船往哪裡走，沒有說誰比較厲害。",
        "why": "A 的如是前往，與題幹比得上不同。",
        "isCorrect": false
      },
      "B": {
        "teacher": "『貓眼黑睛如線』的如表示像線一樣細，是形狀相似而非能力比較。",
        "elementary": "B 說貓的眼睛像一條線。",
        "why": "B 的如是如同，不是比得上。",
        "isCorrect": false
      },
      "C": {
        "teacher": "『悉如外人』是衣著都像外面的人，並沒有誰比誰技術更高的比較。",
        "elementary": "C 是衣服跟外面的人差不多。",
        "why": "C 的如是相像，不是能力高下。",
        "isCorrect": false
      },
      "D": {
        "teacher": "『臣之壯也，猶不如人』的如是比得上，前加不就成比不上別人，與莫能如也同義。",
        "elementary": "D 是『我還比不上人』，跟題目意思相同。",
        "why": "D 與題幹的如都是及得上、比得上的意思。",
        "isCorrect": true
      }
    },
