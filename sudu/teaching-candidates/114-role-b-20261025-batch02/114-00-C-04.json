  "teaching": {
    "topic": "國文｜病句修改需看主語、動詞搭配與錢的流向：歸還＝交回原主人，收回＝拿回自己手中。",
    "teacherSummary": "題文是假檢警詐騙話術。④若要說明『之後把匯走的款項還給民眾』，動詞應改成『歸還匯款』，不是『收回匯款』。A/B 改出主語不明，C 讓存款自行前往法院，故 D 正確。",
    "elementarySummary": "騙子說錢給他之後會還給你；還給原主是『歸還』，不是『收回』。這是騙人的，不能真的匯款。",
    "concept": "病句修改需看主語、動詞搭配與錢的流向：歸還＝交回原主人，收回＝拿回自己手中。",
    "extension": "『國家安全帳戶』在題目中是詐騙話術，不能因此當成正式司法收款流程。",
    "memory": "把錢還回給民眾 → 歸還匯款，選 D。",
    "solvingSteps": [
      "了解詐騙者承諾會將款項還給民眾。",
      "④『收回』與返還原主的方向相反，應用『歸還』。",
      "A/B/C修改反而引發主語或搭配問題，故 D。"
    ],
    "optionExplanations": {
      "A": {
        "teacher": "①改成『因查案時被發現遭歹徒冒名』會使被發現者主語不明，原『發現民眾遭歹徒冒名』較清楚。",
        "elementary": "亂用被發現，會不知道誰被發現。",
        "reason": "改成被動『被發現遭冒名』會模糊誰查案、誰遭冒名的施事受事關係；原句主動發現較清楚。",
        "isCorrect": false
      },
      "B": {
        "teacher": "②改成『告知曾傳喚出庭民眾，卻未到案』會讓民眾黏成修飾對象，未到案的主語不清。",
        "elementary": "原本叫他出庭他沒來，亂改反而不好懂。",
        "reason": "改成『曾傳喚出庭民眾，卻未到案』造成『民眾』修飾對象與未到案的主語不清楚。",
        "isCorrect": false
      },
      "C": {
        "teacher": "③『存款應主動前往法院保管』讓存款做出『前往』動作，語義不合理。",
        "elementary": "錢不會自己走路到法院。",
        "reason": "『存款』不會自行『前往法院』，前往的主語必須是能移動的人，不能是存款本身。",
        "isCorrect": false
      },
      "D": {
        "teacher": "④改『歸還匯款』才能表示把錢交回原來的民眾，符合詐騙話術中的假承諾方向。",
        "elementary": "把錢還給別人叫歸還。",
        "reason": "『歸還匯款』指把錢交回民眾原持有人，符合假檢警承諾退還的方向；『收回』則是往自己取回。",
        "isCorrect": true
      }
    },
