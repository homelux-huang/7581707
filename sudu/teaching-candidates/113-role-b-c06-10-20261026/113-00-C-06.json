  "teaching": {
    "topic": "儒家對聯：孝弟、詩書與上/下聯",
    "teacherSummary": "官方單題原像素右聯是『萬石家風惟○○』，左聯『百年世業在□□』。家風強調儒家所重的孝弟（孝親、友愛兄弟），世業用詩書象徵世代讀書傳家，因此圓圈填孝弟、方框填詩書；兩句結尾『弟』與『書』也符合常見上仄下平的對聯形式，所以 B。",
    "elementarySummary": "右邊是說一家人要孝順、友愛，填『孝弟』；左邊說家族代代讀書，填『詩書』。圓圈放孝弟、方框放詩書，選 B。",
    "concept": "讀對聯要看原圖的左右位置和詞義：右上聯家風偏家庭倫理，左下聯世業偏文化傳承。道家常用的無為、齊物與儒家家訓主題不符。",
    "memory": "家風惟**孝弟**、世業在**詩書**，○○孝弟、□□詩書＝B。",
    "solvingSteps": [
      "原圖依右聯到左聯讀，右側萬石家風惟○○，左側百年世業在□□。",
      "右聯要表家族倫理，選孝弟：孝親與手足友愛。",
      "左聯談世代家業與文化傳承，選詩書：讀書傳家。",
      "選項 B 的先後恰為孝弟／詩書；其他順序或思想脈絡不合。"
    ],
    "optionExplanations": {
      "A": {
        "teacher": "A 將詩書放在家風、孝弟放在世業，文意比不上『家風重孝弟、世業承詩書』，上下聯末字平仄次序也較不恰當。",
        "elementary": "A 把孝順和讀書放錯了右、左位置，讀起來沒有 B 自然。",
        "reason": "詩書與孝弟的語義位置互換，沒有正確回應兩句的家風、世業。",
        "isCorrect": false
      },
      "B": {
        "teacher": "B 讓右側的萬石家風以孝弟為根本，左側百年世業以詩書傳承；既符合儒家教育倫理，也與原圖兩種符號的位置吻合。",
        "elementary": "B 右邊孝弟、左邊詩書，各自放在最適合的句子裡。",
        "reason": "B 同時對應原始圓圈、方框與儒家孝弟及詩書家業的寓意。",
        "isCorrect": true
      },
      "C": {
        "teacher": "C 的無為、齊物是道家思想相關語彙，雖能形式上放入兩個雙字空格，卻不能合理說明儒家家風的孝悌及詩書傳家。",
        "elementary": "C 說的是道家觀念，題目要的是儒家講孝順與讀書。",
        "reason": "無為與齊物沒有對應家風與世業的儒家教育主題。",
        "isCorrect": false
      },
      "D": {
        "teacher": "D 把齊物、無為交換位置，仍然採用道家詞彙，而非題幹所指定的儒家內涵；順序對調不能消除思想來源不符的問題。",
        "elementary": "D 只是把兩個道家的詞交換，仍然沒有講到孝順和詩書。",
        "reason": "D 的詞義仍與題幹儒家家風、讀書傳家不一致，並非正解。",
        "isCorrect": false
      }
    },
