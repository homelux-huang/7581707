  "teaching": {
    "topic": "英文選項語意與情境判讀",
    "teacherSummary": "本題要求選出與句中 abandon 最相近的片語。姐姐決定『放棄』舊習慣，開啟人生新篇章；C give up 可保留停止舊習慣的意思。bring about 是導致、carry on 是繼續、run into 是偶然碰到。",
    "elementarySummary": "姐姐想把舊習慣改掉，重新開始。abandon 就是放棄，所以選 C 的 give up。",
    "concept": "同義詞不能只看字形；abandon habits 與 give up habits 都在說不再做，carry on 正好反向。",
    "memory": "abandon = give up（放棄）；carry on = continue（繼續）。",
    "solvingSteps": [
      "找劃線 abandon 的受詞 old habits：動作是對舊習慣做什麼？",
      "看新生活 fresh chapter：表示離開原有習慣，因此語意是放棄。",
      "四選項代回句中，只有 C give up 能完整替換 abandon。"
    ],
    "optionExplanations": {
      "A": {
        "teacher": "bring about 表促成、導致，例如 bring about change；它不是放棄習慣，換入題幹會變成造成習慣。",
        "elementary": "bring about 是讓事情發生，不是把老習慣丟掉。",
        "reason": "動作方向不同，A 表造成而非停止。",
        "isCorrect": false
      },
      "B": {
        "teacher": "carry on 表繼續進行；carry on her old habits 變成姐姐繼續維持舊習慣，和 abandon 相反。",
        "elementary": "姐姐要停止老習慣，carry on 卻說繼續做，所以錯。",
        "reason": "B 是本題語境下 abandon 的相反意思。",
        "isCorrect": false
      },
      "C": {
        "teacher": "give up 表放棄或停止從事；give up old habits 與 abandon old habits 在此自然同義，後句新篇章也呼應。",
        "elementary": "give up 就是放棄，和改掉老習慣一樣，C 對。",
        "reason": "C 的 give up 能維持整句停止舊習慣的意義。",
        "isCorrect": true
      },
      "D": {
        "teacher": "run into 常指偶然遇到某人或遭逢問題；既不是戒除，也不能自然替換 abandon old habits。",
        "elementary": "run into 像路上剛好碰到朋友，跟改掉習慣不同。",
        "reason": "D 指意外碰到，沒有放棄舊習慣的語義。",
        "isCorrect": false
      }
    },
