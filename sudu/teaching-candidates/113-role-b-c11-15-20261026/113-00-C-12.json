  "teaching": {
    "topic": "〈蘭亭集序〉的欣於所遇：享受當下、自適之樂",
    "teacherSummary": "山上憶良明指大伴旅人用了《蘭亭集序》相同的『快然自足』四字，希望大家在梅花宴**一同體驗『欣於所遇』**。這是欣賞眼前美景、把握短暫相遇的滿足，而非談藉景抒情技巧、把生死視作同一、或政治式樂以天下。B 的『欣於所遇的自適』最切合。",
    "elementarySummary": "大家難得一起賞梅、唱歌，覺得現在這一刻很開心、很滿足。這就是『欣於所遇』，選 B，不是講死亡或天下大事。",
    "concept": "『快然自足』=當下愉快而滿足；『欣於所遇』=對眼前遇到的人和事感到喜悅。本題問得到的思想啟發，非單一寫作修辭。",
    "memory": "快然自足＋欣於所遇＝把握眼前的快樂，B。",
    "solvingSteps": [
      "找原文山上憶良提起的詞『快然自足』，確認它指心裡滿足的感覺。",
      "再讀山上憶良明說希望梅花宴眾人一同體驗『欣於所遇』。",
      "四選項中 B 指眼前遭逢的自得，A文法、C生死、D天下胸懷都不對焦。"
    ],
    "optionExplanations": {
      "A": {
        "teacher": "A 的藉景抒情可說是一種文學手法，但山上憶良這段明白指出『快然自足』與『欣於所遇』，問的是當下情緒與生命感受，不是景物如何寫法。",
        "elementary": "A 只談寫文章的方法，原文是在說大家現在一起賞花有多開心。",
        "reason": "問題問啟發的心境而非修辭技巧，A 未抓住明示的兩組關鍵詞。",
        "isCorrect": false
      },
      "B": {
        "teacher": "B 的『欣於所遇的自適』直接呼應山上憶良希望眾人當下共同感受、快然自足的說話用意，也吻合梅花宴的歡愉場景。",
        "elementary": "B 就是珍惜此刻大家相聚、欣賞梅花的喜悅，因此正確。",
        "reason": "原文明示快然自足與欣於所遇，B 是直接而非推測的語意。",
        "isCorrect": true
      },
      "C": {
        "teacher": "C 的『生死齊一』說不分生死，但故事反而提王羲之『死生亦大矣，豈不痛哉』帶出的痛感；山上憶良要珍惜當下，並不是把生死完全看作相同。",
        "elementary": "C 說生與死沒有差別，文章沒有這樣教，反而說人會因生死傷感。",
        "reason": "『快然自足』不能推導出生命與死亡齊一的領悟，C 偏離焦點。",
        "isCorrect": false
      },
      "D": {
        "teacher": "D 的『樂以天下』是把天下人的幸福當作志業的宏大胸懷，而文本說的是席間一起賞梅、體會相遇喜樂，沒有談普天下的政治抱負。",
        "elementary": "D 把賞梅聚會說成為全世界幸福著想，主題變得太遠。",
        "reason": "宴會共同喜悅不同於以天下為己任的道德政治理想，D 沒有原文支持。",
        "isCorrect": false
      }
    },
