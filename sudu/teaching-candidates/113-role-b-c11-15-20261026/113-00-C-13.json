  "teaching": {
    "topic": "〈梅花歌序〉與〈蘭亭集序〉四組對照：取諸懷抱、悟言與快然自足",
    "teacherSummary": "題目問『理解不適當』。①與❶確有時間、地點、宴集事件的交代；②與❷都描寫初春風和氣清；④與❹『淡然身放，快然自足』和『暫得於己，快然自足』都寫滿足。惟③『忘言一室之裡，開襟烟霞之外』與❸『或取諸懷抱，悟言一室之內；或因寄所託，放浪形骸之外』對應的是室內交談、室外放懷兩種**表達心志與交往方式**，不是『自然美景令人忘我』；故 C 是錯誤理解。",
    "elementarySummary": "A說兩篇都有交代什麼時候、在哪裡聚會；B說天氣舒服；D說心情很開心，這些都對。C卻把『室內談心、室外自在表達』說成單純看風景忘記自己，意思不一樣，所以選 C。",
    "concept": "比較古文句子要看具體主語與行動：室內悟言、室外放浪是人的交往和心情表現；不能看到『烟霞』就說整段只在強調自然美景。",
    "memory": "①時間地點、②天氣、④自足都吻合；③是**室內外交流方式**，不是美景忘我 → C。",
    "solvingSteps": [
      "先看第①對照的時間、地點、集會事由，都有排列敘述，A成立。",
      "看第②兩邊寫初春天氣、風氣和暢，B成立。",
      "看第③與❸描述室內交談、室外抒懷等人際與表達方式，並未只強調自然美景令人忘我，故 C 不適當。",
      "再核第④與❹都明寫快然自足的心理狀態，D成立，所以唯一選 C。"
    ],
    "optionExplanations": {
      "A": {
        "teacher": "A 指①與❶皆依時間、地點、事件介紹宴會背景：天平二年正月十三日與永和九年暮春、帥老之宅與蘭亭、宴會與修禊，對照成立，並非本題錯項。",
        "elementary": "A 兩段都有說何時、何地、做什麼，這個理解正確。",
        "reason": "兩篇首段均依聚會日期、場合與活動敘述，A 有逐句證據。",
        "isCorrect": false
      },
      "B": {
        "teacher": "B 指②和❷都描寫當天氣候的舒適，梅花歌序的『氣淑風和』與蘭亭的『天朗氣清、惠風和暢』均有明確風和氣佳的感受，故成立。",
        "elementary": "B 兩篇都說天氣好、風吹得很舒服，沒有看錯。",
        "reason": "②氣淑風和與❷天朗氣清、惠風和暢都支持 B 的天候描述。",
        "isCorrect": false
      },
      "C": {
        "teacher": "C 說③與❸皆強調自然美景使人忘我，但原文是室內『忘言/悟言』、室外『開襟/放浪』對比人的表達及交往方式，不能把人的兩種活動簡化成賞景忘我。",
        "elementary": "C 把室內聊天、室外自在活動，硬說成只因風景太美而忘掉自己，講錯重點。",
        "reason": "③與❸重點在人與人的交流、志趣和行動樣態，非共同的自然景觀忘我效果。",
        "isCorrect": true
      },
      "D": {
        "teacher": "D 指④與❹描述內心喜悅而滿足，兩邊都直接出現『快然自足』，梅花歌序另有『淡然身放』，所以比對完全合理，不能選為不適當。",
        "elementary": "D 兩篇都說心裡很快樂、很滿足，而且都有快然自足四字。",
        "reason": "④與❹共享快然自足原詞，D 的心理感受判斷有直接引文。",
        "isCorrect": false
      }
    },
