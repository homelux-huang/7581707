  "teaching": {
    "topic": "字彙搭配｜authority to punish",
    "teacherSummary": "句型 have the authority to + 原形動詞表示『有做某事的合法權限』。政府能依法處罰酒後駕車，因此選 authority。",
    "elementarySummary": "政府依法律可以處理酒駕，就像學校老師有權維持秩序。空格是在問『有沒有這個權力』。",
    "concept": "authority 表權限；to punish 是不定詞補述這個權限可用來做什麼。",
    "extension": "the authorities 是『主管機關／執法機關』，不等於這題抽象的 authority（權限）。",
    "memory": "政府有權依法處罰 → have the authority to punish。",
    "source": "114 統測英文原題與單題原圖；官方最終答案影像個別核對、教材版本、章節及頁碼待核對。",
    "optionExplanations": {
      "A": {
        "teacher": "正確。authority（權限）可和 have the ... to punish 搭配，符合依法處罰酒駕的句意。",
        "elementary": "政府有權照法律處理酒駕，所以選『權限』。",
        "reason": "權限與後面的 to punish 在語法、語意上都吻合。",
        "isCorrect": true
      },
      "B": {
        "teacher": "錯誤。bargain 是交易或討價還價，不表示政府的法定處罰權。",
        "elementary": "政府不是在和酒駕者討價還價。",
        "reason": "名詞語義不符合依法處罰。",
        "isCorrect": false
      },
      "C": {
        "teacher": "錯誤。courtesy 是禮貌、好意，不能表達依法執法的權力。",
        "elementary": "有禮貌不等於有法律授權。",
        "reason": "禮貌並非權限。",
        "isCorrect": false
      },
      "D": {
        "teacher": "錯誤。infection 是感染／傳染，與酒駕處罰或法定權限無關。",
        "elementary": "生病感染和警察處理酒駕是兩回事。",
        "reason": "領域與語意完全不符。",
        "isCorrect": false
      }
    },
