  "teaching": {
    "topic": "國文語法｜把字句的有意處置與無意導致",
    "teacherSummary": "題幹把『把』的作用分為有意識處置與非有意識的結果。C 的船身划開海水是船體航行所造成的現象，船身並沒有主觀意圖，故符合②『導致』。",
    "elementarySummary": "樹擋住路不是樹故意的；同樣地，船身讓海水翻成白浪，也不是船身決定要去做，答案是 C。",
    "concept": "重點不是看有沒有『把』，而是判斷『把』前的主語有沒有主動安排這個動作。",
    "extension": "擬人、譬喻句也須判斷句子所描述的實際因果，不能因為用了動詞就一律當成有意識處置。",
    "memory": "人主動做 → 處置；物體造成結果 → 導致，選『船身把海水……』。",
    "source": "114 統測國文第2題含右框兩種定義之文字與單題原圖；官方最終答案影像個別核對及教材頁碼待核對。",
    "optionExplanations": {
      "A": {
        "teacher": "錯誤。『妳要把岳飛的精神演出來』，演出者有意識地展現精神，屬①處置。",
        "elementary": "演員自己決定怎麼演，這是主動做。",
        "reason": "人的有意行為。",
        "isCorrect": false
      },
      "B": {
        "teacher": "錯誤。『余燕翼把……飯倒回鍋裡』，人刻意倒飯，屬①處置。",
        "elementary": "他自己把飯倒回去，是主動做的。",
        "reason": "人的有意行為。",
        "isCorrect": false
      },
      "C": {
        "teacher": "正確。『船身把墨藍海水掘犁成翻花的白浪』是船身造成波浪，並非船身有意安排，屬②導致。",
        "elementary": "船前進，海水自然翻出白浪；船身不會故意想事情。",
        "reason": "無意識主語造成結果。",
        "isCorrect": true
      },
      "D": {
        "teacher": "錯誤。『母親只好把……短髮剪去』有人的剪髮決定，屬①處置。",
        "elementary": "媽媽拿剪刀把頭髮剪掉，是自己決定做的。",
        "reason": "有意識剪去頭髮。",
        "isCorrect": false
      }
    },
