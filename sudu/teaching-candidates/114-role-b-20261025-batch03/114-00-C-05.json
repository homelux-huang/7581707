  "teaching": {
    "topic": "國文句序｜關聯詞與對比銜接",
    "teacherSummary": "先配對①『不僅在於』與⑤『更在於』，再配對④『既透過』與③『也運用』，最後讓②『與無情的生存遊戲形成對比』承接③純真英熙娃娃形象，因此順序為①⑤④③②，答案B。",
    "elementarySummary": "像組句子積木：不僅後面要接更；既後面要接也；講可愛娃娃才能接跟殘酷遊戲比一比，選B。",
    "concept": "『不僅…更在於』是遞進，『既…也…』是並列，最後以純真與殘酷形成語義對比。",
    "extension": "文章談劇本文化符號的呈現手法，不能從此推斷所有觀眾都產生同一感受。",
    "memory": "①不僅→⑤更；④既→③也；③純真→②殘酷對比：選 B①⑤④③②。",
    "solvingSteps": [
      "①不僅在於後應承接⑤更在於，強調文化價值。",
      "④既透過與③也運用說明兩項並列文化呈現手法。",
      "②與無情遊戲形成對比要緊接③娃娃的純真形象。",
      "完整排序①⑤④③②，最後自然銜接『為全劇帶來強烈的視覺與情感衝擊』。"
    ],
    "optionExplanations": {
      "A": {
        "teacher": "A排列①③④⑤②使③『也運用』出現在④『既透過』前，而且拆散①不僅和⑤更在於，違反兩組關聯詞的先後搭配。",
        "elementary": "這像把『也』放在『既』前，又把『不僅』和『更』拆開，句子接不順。",
        "reason": "①不僅與⑤更在於宜相連，④既與③也宜相連，A將兩組句式的前後關係都打亂。",
        "isCorrect": false
      },
      "B": {
        "teacher": "B排列①⑤④③②先接『不僅…更在於』，再接『既…也…』，最後由③英熙娃娃的純真形象承接②殘酷遊戲對比。",
        "elementary": "先配好兩對詞語，再讓可愛娃娃和殘酷遊戲作比較，就全部接上了。",
        "reason": "B同時符合①⑤遞進、④③並列，以及③純真娃娃與②無情遊戲形成對比的語意連接。",
        "isCorrect": true
      },
      "C": {
        "teacher": "C排列④②③①⑤把②對比放在③純真娃娃出現之前，④『既』與③『也』之間被②打斷，段落推理顛倒。",
        "elementary": "還沒說可愛娃娃，就先說跟恐怖遊戲比較，還打斷『既…也…』。",
        "reason": "②需要③已提及純真形象才有清楚的對比對象，④既與③也被錯誤插入②，不能連貫。",
        "isCorrect": false
      },
      "D": {
        "teacher": "D排列④⑤③②①讓④『既』錯接⑤『更在於』，最後①『不僅』沒有後續『更在於』呼應，語法與邏輯都不完整。",
        "elementary": "把『更』放在『不僅』前面，最後只說『不僅』卻沒說更重要的是什麼。",
        "reason": "①不僅不能在⑤更在於之後，且④既應接③也而非⑤，D兩組搭配都不成立。",
        "isCorrect": false
      }
    },
