    "examCalculation": {
      "given": [
        "AB＝7公里，AC＝8公里",
        "∠ACB＝60°，BC＞4公里"
      ],
      "formulaUse": "c²＝a²＋b²－2ab cosC，其中c是角C的對邊。",
      "substitution": [
        "7²＝8²＋x²－2×8×x×cos60°"
      ],
      "steps": [
        "設BC＝x公里，cos60°＝1／2。",
        "49＝64＋x²－2×8×x×(1／2)＝64＋x²－8x。",
        "移項得x²－8x＋15＝0。",
        "因式分解：(x－3)(x－5)＝0，故x＝3或5。",
        "由x＞4，排除3，得到BC＝5公里，選 A。",
        "代回：64＋25－40＝49＝7²，符合原條件。"
      ],
      "result": "5公里",
      "unit": "公里",
      "option": "A"
    },
