  "teaching": {
    "topic": "國文閱讀｜外在言行與人物內心的敘事視角",
    "teacherSummary": "甲文敘述巡警怎樣開口刁難、變臉、生氣與奪秤，側重外顯言行及情緒；乙文除描述查大人打孩童，更深入寫出他擔心官員尊嚴受損的內心盤算。選項 B 能準確比較兩篇筆法。",
    "elementarySummary": "甲文多告訴我們警察說了什麼、做了什麼；乙文還告訴我們官員心裡在想什麼。這就是 B。",
    "concept": "敘事觀點要分清作者、人物與街上路人，也要分清外在行為與直接呈現內心想法。",
    "extension": "作者敘事對濫用權力的批評不等於當事人自己承認錯誤；『誠實的參』『不幸這個兒童』屬敘事評語，不可直接歸給施暴者。",
    "memory": "甲：巡警外在行為＋情緒；乙：查大人內心盤算；選 B。",
    "solvingSteps": [
      "看甲文：巡警語氣與臉色改變、責備攤販、奪秤，主要由外在言行看其情緒。",
      "看乙文：除查大人責打孩童，原文還直接交代他擔心做官尊嚴、不能讓民眾插手的想法。",
      "逐項比較敘事角度，只有 B 明確指出甲重外在、乙揭內心。"
    ],
    "optionExplanations": {
      "A": {
        "teacher": "A 說兩篇都由街上路人視角客觀冷靜敘事，但原文由敘述者統攝場面，並未全程借路人眼睛看；還帶入對濫權者的批判。",
        "elementary": "不是兩篇都由路人當攝影機來說故事，作者也在表達看法。",
        "reason": "甲乙都非僅街上路人的視角，選項以單一旁觀者誤認敘述者。",
        "isCorrect": false
      },
      "B": {
        "teacher": "B 指出甲文側寫巡警的言行與情緒變化，乙文進一步透露查大人的官威心理；原文兩篇對人物內外層次安排正是如此。",
        "elementary": "甲文多寫警察做什麼；乙文連官員心裡怕沒面子都寫出來。",
        "reason": "甲外在言行、乙內心想法的對照可在兩篇原文分別找到具體敘述。",
        "isCorrect": true
      },
      "C": {
        "teacher": "C 將『誠實的參』歸於巡警感受，『不幸這個兒童』歸查大人感受；實際兩語用來凸顯受害者處境，與恃權欺人的施暴者看法相反。",
        "elementary": "欺負人的人不是在同情受害者，這些是說故事的人讓讀者看到的。",
        "reason": "把敘事者對弱者的同情誤判為巡警與查大人自己的情感，是視角混淆。",
        "isCorrect": false
      },
      "D": {
        "teacher": "D 說『不去嗎』『不說嗎』不只強調蠻橫，還都顯示受群眾威脅的不安；但甲文巡警無民眾威脅的共同線索，乙文亦更重官威。",
        "elementary": "兩句都很兇，卻不能因此說兩位官員都被路人嚇到了。",
        "reason": "兩個喝斥語能見威逼，不能從中同時推出兩人均受群眾威脅而不安。",
        "isCorrect": false
