      ],
      "formulaUse": "八折＝原價×0.8；同行兩人且只有一人八折，總額＝原價×(1＋0.8)。",
      "substitution": [
        "x＋(x－3000)＝(x＋2000)＋0.8(x＋2000)"
      ],
      "steps": [
        "行程Ⅰ總額＝x＋x－3000＝2x－3000。",
        "行程Ⅱ總額＝(1＋0.8)(x＋2000)＝1.8x＋3600。",
        "令總額相等：2x－3000＝1.8x＋3600。",
        "兩邊減1.8x並加3000：0.2x＝6600。",
        "兩邊除0.2：x＝33000。",
        "驗算Ⅰ：33000＋30000＝63000元。",
        "驗算Ⅱ：35000＋35000×0.8＝35000＋28000＝63000元，選 B。"
      ],
